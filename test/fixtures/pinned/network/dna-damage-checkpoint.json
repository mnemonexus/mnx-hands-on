      },
      {
        "from": "cdc25",
        "to": "cdk",
        "sign": "+",
        "reason": "Cdc25 removes the inhibitory phosphate, which leaves the Cdk active.",
        "claim": "fb4"
      },
      {
        "from": "cdk",
        "to": "prog",
        "sign": "+",
        "reason": "Active cyclin-Cdk complexes drive the cell on through the cycle.",
        "claim": "cs3"
      },
      {
        "from": "cdk",
        "to": "cdc25",
        "notModelled": "Active M-Cdk switches on Cdc25, which switches on M-Cdk. A loop like that is a switch with two stable states, which levels cannot settle on."
      }
    ],
