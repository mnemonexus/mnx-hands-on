  "spec": {
    "story": "A neuron with misfolded prion protein. Translation is already held down a little.",
    "nodes": [
      {
        "id": "unf",
        "label": "Unfolded prion protein",
        "x": 12,
        "y": 16
      },
      {
        "id": "kin",
        "label": "PERK kinase",
        "x": 37,
        "y": 16
      },
      {
        "id": "gadd",
        "label": "GADD34 phosphatase",
        "x": 37,
        "y": 50,
        "level": "low"
      },
      {
        "id": "eifp",
        "label": "eIF2α-P",
        "x": 62,
        "y": 16,
        "note": "Phosphorylated eIF2 alpha."
      },
      {
        "id": "eif2b",
        "label": "Free eIF2B",
        "x": 62,
        "y": 50
      },
      {
        "id": "ter",
        "label": "Ternary complex",
        "x": 87,
        "y": 50
      },
      {
        "id": "trans",
        "label": "Global translation",
        "x": 87,
        "y": 84
      },
      {
        "id": "syn",
        "label": "Synapse number",
        "x": 62,
        "y": 84
      }
    ],
    "edges": [
      {
        "from": "unf",
        "to": "kin",
        "sign": "+",
        "reason": "BiP recognises the unfolded prion protein, which triggers PERK kinase phosphorylation.",
        "claim": "p38"
      },
      {
        "from": "kin",
        "to": "eifp",
        "sign": "+",
        "reason": "PERK kinase phosphorylates the alpha subunit of eIF2.",
        "claim": "p39"
      },
      {
        "from": "gadd",
        "to": "eifp",
        "sign": "-",
        "reason": "GADD34 is an eIF2α phosphatase, so it takes the phosphate off again.",
        "claim": "p42"
      },
      {
        "from": "eifp",
        "to": "eif2b",
        "sign": "-",
        "reason": "Phosphorylated eIF2 holds on to eIF2B, so eIF2B is sequestered and cannot exchange GDP for GTP.",
        "claim": "p26"
      },
      {
        "from": "eif2b",
        "to": "ter",
        "sign": "+",
        "reason": "Free eIF2B recycles eIF2.GDP to eIF2.GTP, which can take up initiator tRNA again.",
        "claim": "p20"
      },
      {
        "from": "ter",
        "to": "trans",
        "sign": "+",
        "reason": "The ternary complex delivers the initiator tRNA, so initiation can continue.",
        "claim": "p28"
      },
      {
        "from": "trans",
        "to": "syn",
        "sign": "+",
        "reason": "Neuronal plasticity and making synapses need translation.",
        "claim": "p34"
      },
      {
        "from": "trans",
        "to": "unf",
        "notModelled": "Less translation means less new unfolded protein, which would ease the signal. But it removes none already made (p51). That loop is left out."
      }
    ],
    "outputs": [
      "eifp",
      "trans",
      "syn"
    ],
    "perturbations": [
      {
        "id": "shprp",
        "node": "unf",
        "kind": "remove",
        "label": "Block the prion protein piling up"
      },
      {
        "id": "gadd34",
        "node": "gadd",
        "kind": "more",
        "label": "Overexpress GADD34"
      },
      {
        "id": "salub",
        "node": "gadd",
        "kind": "block",
        "label": "Treat with salubrinal"
      },
      {
        "id": "s51a",
        "node": "eifp",
        "kind": "remove",
        "label": "Make eIF2α unable to be phosphorylated",
        "outputs": [
          "eif2b",
          "trans",
          "syn"
        ]
      }
    ],
    "note": "Making eIF2 unable to be phosphorylated comes from the lecture's stress experiment, not from the prion mice."
  }
}
